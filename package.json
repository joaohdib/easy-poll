{
  "name": "easypoll",
  "version": "1.0.0",
  "private": true,
  "description": "EasyPoll — aplicativo local para criar enquetes em grupos do WhatsApp",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "concurrently --kill-others --names server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "node scripts/wait-for-backend.js && vite frontend --config frontend/vite.config.ts --configLoader runner",
    "build": "npm run build:server && npm run typecheck:web && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build frontend --config frontend/vite.config.ts --configLoader runner",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "typecheck:server": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p frontend/tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run build:web",
    "smoke:web": "node scripts/frontend-smoke.js",
    "test": "tsx --test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "express": "5.1.0",
    "lucide-react": "^1.33.0",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "drizzle-kit": "0.31.10",
    "nodemon": "3.1.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  }
}
