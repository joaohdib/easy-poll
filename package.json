{
  "name": "easypoll",
  "version": "1.0.0",
  "private": true,
  "description": "EasyPoll — aplicativo local para criar enquetes em grupos do WhatsApp",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && node --check public/app.js && node --check public/stats.js",
    "test": "tsx --test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "express": "5.1.0",
    "qrcode": "1.5.4",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "0.31.10",
    "nodemon": "3.1.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
